APP_ENV=local
LOG_LEVEL=INFO

# Leave FOUNDRY_PROJECT_ENDPOINT empty to run in MOCK mode (no Azure needed).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_NAME=gpt-4o

# ── Durable memory (Azure Cosmos DB) ─────────────────────────────────────
# Set the connection string to switch session memory from in-memory to Cosmos DB.
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE=agentmemory
COSMOS_CONTAINER=sessions
